s text-[#F8FAFC]/90","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check w-3.5 h-3.5 text-[#22C55E] flex-shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":"Xử lý hồ sơ thầu, báo giá và tài liệu kỹ thuật hoàn toàn nội bộ (Offline)"}]]}],["$","li","1",{"className":"flex items-start gap-2 text-xs text-[#F8FAFC]/90","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check w-3.5 h-3.5 text-[#22C55E] flex-shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":"Xóa sạch Metadata ẩn (tên thiết bị, tác giả, phần mềm) trước khi gửi đối tác"}]]}],["$","li","2",{"className":"flex items-start gap-2 text-xs text-[#F8FAFC]/90","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check w-3.5 h-3.5 text-[#22C55E] flex-shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":"Tận dụng hạ tầng Microsoft Office hoặc LibreOffice sẵn có của doanh nghiệp"}]]}]]}],["$","div",null,{"className":"flex flex-wrap gap-1.5 pt-1","children":[["$","span","Thông tin & Metadata",{"className":"px-2 py-0.5 rounded-md bg-[#1C1834] border border-[#A78BFA]/20 text-[10px] font-medium text-[#A78BFA]","children":"Thông tin & Metadata"}],["$","span","Gộp PDF",{"className":"px-2 py-0.5 rounded-md bg-[#1C1834] border border-[#A78BFA]/20 text-[10px] font-medium text-[#A78BFA]","children":"Gộp PDF"}],["$","span","Chỉnh sửa trang",{"className":"px-2 py-0.5 rounded-md bg-[#1C1834] border border-[#A78BFA]/20 text-[10px] font-medium text-[#A78BFA]","children":"Chỉnh sửa trang"}],["$","span","Nén PDF",{"className":"px-2 py-0.5 rounded-md bg-[#1C1834] border border-[#A78BFA]/20 text-[10px] font-medium text-[#A78BFA]","children":"Nén PDF"}]]}]]}],["$","div",null,{"className":"pt-4 mt-5 border-t border-[#A78BFA]/12","children":["$","$L5",null,{"href":"/privacy","className":"inline-flex items-center gap-1.5 text-xs font-bold text-[#A78BFA] hover:text-white transition-colors","children":[["$","span",null,{"children":"Xem chính sách quyền riêng tư"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-3.5 h-3.5","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}]]}]]}]]}]}],["$","$L6",null,{}],["$","$L7",null,{}],["$","section",null,{"id":"faq","className":"py-16 lg:py-24 bg-[#151228]/40 border-t border-[#A78BFA]/15","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"text-center space-y-3 mb-10","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#1C1834] border border-[#A78BFA]/25 text-xs font-semibold text-[#A78BFA]","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help w-3.5 h-3.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","span",null,{"children":"Câu hỏi thường gặp"}]]}],["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-[#F8FAFC]","children":"Giải đáp thắc mắc về PDF Tools NCN"}],["$","p",null,{"className":"text-xs sm:text-sm text-[#A5A0BC]","children":"Thông tin rõ ràng về tính năng có sẵn, yêu cầu Microsoft Office / LibreOffice, Tesseract OCR và cơ chế bảo vệ quyền riêng tư cục bộ."}]]}],["$","$L8",null,{"items":[{"id":"what-is-pdf-tools-ncn","category":"general","question":"PDF Tools NCN là gì?","answer":"PDF Tools NCN là ứng dụng desktop dành cho hệ điều hành Windows 10 và Windows 11 (64-bit), tích hợp các công cụ xử lý tài liệu PDF phổ biến như gộp PDF, tách trang, xoay & sắp xếp trang trực quan, nén giảm dung lượng, đóng dấu watermark, đánh số trang, chuyển đổi định dạng Office/Ảnh và OCR tiếng Việt trong một giao diện tiếng Việt thống nhất."},{"id":"is-it-free","category":"general","question":"Ứng dụng có miễn phí không?","answer":"Phiên bản hiện tại (v1.0.0) của PDF Tools NCN được phát hành miễn phí để tải về và sử dụng đầy đủ các tính năng trên máy tính cá nhân Windows, không yêu cầu đăng ký tài khoản và không gắn nhãn bản quyền (watermark) bắt buộc lên tài liệu đầu ra của bạn."},{"id":"does-it-need-internet","category":"privacy","question":"Ứng dụng có cần kết nối Internet khi sử dụng không?","answer":"Không. Sau khi bạn đã tải và cài đặt PDF Tools NCN lên máy tính, toàn bộ các chức năng xử lý PDF đều hoạt động offline 100% mà không phụ thuộc vào kết nối mạng."},{"id":"are-files-uploaded","category":"privacy","question":"Tài liệu của tôi có bị tải lên máy chủ (server) nào không?","answer":"Không. PDF Tools NCN được thiết kế theo kiến trúc xử lý cục bộ (Local-first). Mọi thao tác đọc tệp, hiển thị hình ảnh từng trang, gộp, tách, nén hay chuyển đổi đều diễn ra trực tiếp trên CPU và ổ cứng máy tính của bạn. Không có bất kỳ tệp tài liệu nào được gửi ra máy chủ bên ngoài."},{"id":"how-to-merge-pdf","category":"features","question":"Làm thế nào để gộp nhiều file PDF thành một file duy nhất?","answer":"Bạn mở ứng dụng, chọn công cụ \"Gộp PDF\", sau đó kéo thả hoặc chọn các tệp PDF từ máy tính. Giao diện sẽ hiển thị hình ảnh trực quan các trang của từng tệp. Bạn có thể dùng mũi tên lên/xuống để đổi thứ tự tệp, nhập khoảng trang cần lấy (ví dụ: 1-5) hoặc giữ mặc định toàn bộ, rồi nhấn \"Thực hiện: Gộp PDF\"."},{"id":"can-convert-word-to-pdf","category":"engines","question":"Ứng dụng có thể chuyển Word, Excel, PowerPoint sang PDF không?","answer":"Có. Khi máy tính của bạn đã cài đặt sẵn Microsoft Office (Word, Excel, PowerPoint bản 2016/2019/2021/365) hoặc bộ ứng dụng miễn phí LibreOffice, PDF Tools NCN sẽ tự động kết nối với engine có sẵn trên máy để xuất tệp Word (.docx, .doc), Excel (.xlsx, .xls) và PowerPoint (.pptx, .ppt) sang PDF chuẩn xác."},{"id":"can-convert-pdf-to-excel","category":"engines","question":"Có thể chuyển đổi ngược từ PDF sang Word hoặc Excel không?","answer":"Ứng dụng hỗ trợ chuyển đổi PDF sang Word (.docx), Excel (.xlsx) và PowerPoint (.pptx) thông qua Microsoft Office hoặc LibreOffice trên máy. Lưu ý rằng chất lượng giữ bố cục và bảng biểu phụ thuộc vào việc file PDF gốc có lớp văn bản chuẩn hay là file scan hình ảnh. Với PDF scan, bạn nên chạy công cụ OCR trước."},{"id":"why-libreoffice-or-msoffice","category":"engines","question":"Vì sao các tính năng chuyển đổi Office cần Microsoft Office hoặc LibreOffice?","answer":"Để giữ bộ cài đặt PDF Tools NCN gọn nhẹ (~3 MB) và xử lý hoàn toàn offline mà không đẩy tài liệu lên đám mây, ứng dụng tận dụng trực tiếp bộ dựng tài liệu chuẩn của Microsoft Office (nếu máy bạn đã có sẵn) hoặc LibreOffice headless (mã nguồn mở, miễn phí). Nếu máy chưa có cả hai công cụ này, ứng dụng sẽ thông báo rõ và cung cấp liên kết tải LibreOffice chính thức."},{"id":"how-vietnamese-ocr-works","category":"engines","question":"Tính năng OCR tiếng Việt hoạt động như thế nào?","answer":"Tính năng OCR sử dụng động cơ mã nguồn mở Tesseract OCR được cài đặt trên máy tính của bạn. Khi bạn cài Tesseract kèm gói dữ liệu ngôn ngữ Tiếng Việt (vie.traineddata), PDF Tools NCN sẽ gọi trực tiếp engine này để nhận dạng chữ tiếng Việt có dấu và tiếng Anh từ tệp scan mà không cần gửi ảnh lên dịch vụ trực tuyến."},{"id":"supported-windows-versions","category":"system","question":"Ứng dụng hỗ trợ những phiên bản Windows nào?","answer":"PDF Tools NCN hỗ trợ Windows 10 (64-bit, bản cập nhật 1803 trở lên) và Windows 11 (64-bit). Bộ cài đặt định dạng chuẩn Setup.exe (NSIS) giúp cài đặt nhanh trong vài giây và tự động tạo lối tắt trên Desktop cũng như Start Menu."},{"id":"how-to-update","category":"system","question":"Làm thế nào để kiểm tra và cập nhật phiên bản mới?","answer":"Bạn có thể xem phiên bản hiện tại ở góc dưới cùng hoặc trong mục Giới thiệu của ứng dụng, sau đó truy cập trang Tải xuống (/download) hoặc Lịch sử cập nhật (/changelog) trên website chính thức của PDF Tools NCN để tải bộ cài đặt mới nhất. Khi cài bản mới đè lên, lịch sử tác vụ và cài đặt cục bộ của bạn vẫn được giữ nguyên."},{"id":"where-to-contact-support","category":"general","question":"Tôi có thể báo lỗi hoặc đề xuất thêm tính năng mới ở đâu?","answer":"Bạn có thể gửi trực tiếp phản hồi, báo lỗi kỹ thuật hoặc yêu cầu tính năng mới tại trang Liên hệ (/contact) trên website này. Đội ngũ phát triển NCN tiếp nhận mọi ý kiến đóng góp để hoàn thiện sản phẩm qua từng phiên bản."}]}]]}]}],["$","section",null,{"className":"py-16 lg:py-24 border-t border-[#A78BFA]/15 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 bg-gradient-to-r from-[#7657F6]/10 via-transparent to-[#A78BFA]/10 pointer-events-none","aria-hidden":"true"}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6","children":[["$","h2",null,{"className":"t