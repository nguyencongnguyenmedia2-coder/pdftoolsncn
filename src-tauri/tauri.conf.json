{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Tools NCN",
  "version": "1.0.0",
  "identifier": "com.pdftools.ncn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Tools NCN - Gộp, Chỉnh sửa & Chuyển đổi PDF",
        "width": 1150,
        "height": 780,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
